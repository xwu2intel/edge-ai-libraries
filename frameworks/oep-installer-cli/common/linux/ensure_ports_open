
# ensure ports are open
ensure_ports_open () {
  if command -v ss > /dev/null; then
    echo "Missing ss on the system" >&2
    return 1
  fi
  local port out
  for port in "$@"; do
    out="$(ss -Hltunp "sport = :$port")" || continue
    [ -n "$out" ] || continue
    printf "${red}port %s occupied${reset}\n%s\n" "$port" "$out" >&2
    act_helper "stop," "-r" --continue
    [ -n "$(ss -Hltuanp "sport = :$port")" ] || continue
    printf "${red}port %s is occupied${reset}" "$port" 1>&2
    return 3
  done
}

